{
  "name": "@duskmoon-dev/rollup",
  "version": "1.0.0",
  "description": "build tools of @duskmmon-dev",
  "type": "module",
  "bin": {
    "dm-rollup": "./dist/dm-rollup.cjs"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json",
    "./*": {
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.cjs"
    }
  },
  "scripts": {
    "build": "npm-run-all --serial clean build:*",
    "build:esm": "tsc --module esnext --target es2021 --outDir dist/esm",
    "build:cjs": "tsc --module commonjs --target es5 --outDir dist/cjs",
    "build:bundle": "rollup -c rollup.config.js",
    "rename-to-cjs": "rename-to-cjs 'dist/cjs/**/*.js'",
    "test": "jest --passWithNoTests",
    "lint": "eslint --config ../../eslint.config.js --fix src",
    "clean": "rimraf dist"
  },
  "keywords": [
    "duskmoon",
    "build-tools"
  ],
  "author": "Jonathan Gao",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "dist"
  ],
  "devDependencies": {
    "@duskmoon-dev/rename-to-cjs": "workspace:^",
    "@duskmoon-dev/tsconfig": "workspace:^",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.2.1",
    "jest": "^30.0.5",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-dynamic-import-vars": "^2.1.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@rollup/plugin-wasm": "^6.2.2",
    "commander": "^14.0.0",
    "eslint": "^9.33.0",
    "rollup": "^4.46.2",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
