{
  "name": "@duskmoon-dev/rename-to-cjs",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "bin": {
    "rename-to-cjs": "./bin/rename-to-cjs.js"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json",
    "./*": {
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.cjs"
    }
  },
  "scripts": {
    "build": "npm-run-all --serial clean build:* rename-to-cjs",
    "build:esm": "tsc --module esnext --target es2021 --outDir dist/esm",
    "build:cjs": "tsc --module commonjs --target es5 --outDir dist/cjs",
    "rename-to-cjs": "node bin/rename-to-cjs.js 'dist/cjs/**/*.js'",
    "test": "jest",
    "clean": "rimraf dist"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "glob": "^11.0.3"
  },
  "devDependencies": {
    "@duskmoon-dev/tsconfig": "workspace:^",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
