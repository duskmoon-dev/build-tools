{
  "name": "@duskmoon-dev/pkg-utils",
  "version": "1.0.0",
  "description": "package utils of @duskmmon-dev",
  "type": "module",
  "bin": {
    "dm-cli": "bin/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "npm-run-all --parallel build:*",
    "build:esm": "tsc --module esnext --target es2021 --outDir dist/esm",
    "build:cjs": "tsc --module commonjs --target es5 --outDir dist/cjs",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint --config ../../eslint.config.js --fix src",
    "clean": "del dist"
  },
  "keywords": [
    "duskmoon",
    "duskmoon-dev",
    "utils"
  ],
  "author": "Jonathan Gao",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@duskmoon-dev/tsconfig": "workspace:^",
    "@jest/globals": "^30.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "jest": "^30.0.5",
    "npm-run-all": "^4.1.5",
    "del-cli": "^6.0.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "typescript": "^5.9.2"
  }
}
