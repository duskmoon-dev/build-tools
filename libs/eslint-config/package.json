{
  "name": "@duskmoon-dev/eslint-config",
  "version": "1.0.0",
  "description": "eslint config of @duskmoon-dev",
  "main": "index.js",
  "scripts": {
    "find-new-rules": "npm-run-all --parallel find-new-rules:*",
    "find-new-rules:main": "eslint-find-rules --unused ./index.js",
    "lint": "eslint --config index.js .",
    "test": "npm-run-all --parallel lint find-new-rules",
    "validate": "npm-run-all --parallel lint test"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "config",
    "javascript",
    "styleguide"
  ],
  "author": "Jonathan Gao",
  "license": "MIT",
  "eslintConfig": {
    "extends": "./index.js"
  },
  "eslintIgnore": [
    "node_modules",
    "coverage",
    "dist"
  ],
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-jsconfig": "~1.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.6.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "eslint": "^9.33.0",
    "eslint-find-rules": "^5.0.0",
    "jest": "^30.0.5",
    "npm-run-all": "^4.1.5",
    "prettier": "3.6.2",
    "pretty-quick": "^4.2.2",
    "react": "^19.1.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "eslint": "^8.0.0",
    "typescript": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
