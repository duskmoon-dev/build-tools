{
  "name": "build-tools",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "cli",
    "commands/*",
    "libs/*"
  ],
  "scripts": {
    "build": "bun run --filter \"@duskmoon-dev/*\" build",
    "dev": "bun run --filter \"@duskmoon-dev/*\" dev",
    "lint": "bun run --filter \"@duskmoon-dev/*\" lint",
    "test": "bun run --filter \"@duskmoon-dev/*\" test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@duskmoon-dev/eslint-config": "workspace:*",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.2.14"
}
